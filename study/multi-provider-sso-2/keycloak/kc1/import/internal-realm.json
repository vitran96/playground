{
  "id": "internal",
  "realm": "internal",
  "displayName": "Company Internal Realm",
  "enabled": true,
  "loginTheme": "kc1-internal",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Standard corporate employee"
      },
      {
        "name": "app-admin",
        "description": "Application administrator"
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@internal.email.com",
      "firstName": "Alice",
      "lastName": "Engineer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee",
        "app-admin"
      ]
    },
    {
      "username": "bob",
      "email": "bob@internal.email.com",
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "app-arch3-int",
      "name": "Architecture 3 Internal Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_SECRET_APP_ARCH3_INT}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://int.localhost:8301/api/architecture-3/login/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://int.localhost:8301/architecture-3/*##"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "app-arch4-int",
      "name": "Architecture 4 Internal Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_SECRET_APP_ARCH4_INT}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://int.localhost:8401/api/architecture-4/login/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://int.localhost:8401/architecture-4/*##"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "kc2-broker",
      "name": "Keycloak 2 Broker Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC2_BROKER_SECRET}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8082/realms/external/broker/internal-kc1/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8082/realms/external/*##"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ]
}
