# Kerberos client configuration for Active Directory integration
# Copy to krb5.conf and populate with your corporate domain details.

[libdefaults]
  default_realm = CORP.EXAMPLE.COM
  dns_lookup_kdc = true
  rdns = false
  default_tkt_enctypes = aes256-cts-hmac-sha1-96
  default_tgs_enctypes = aes256-cts-hmac-sha1-96

[realms]
  CORP.EXAMPLE.COM = {
    kdc = dc1.corp.example.com
    kdc = dc2.corp.example.com
  }

[domain_realm]
  .corp.example.com = CORP.EXAMPLE.COM
