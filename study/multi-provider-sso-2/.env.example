# Development environment configuration
# In production, use strong random secrets and COOKIE_SECURE=true

JWT_SECRET=dev-jwt-secret-key-change-me-in-production-min-32-bytes
COOKIE_SECURE=false
OIDC_CRYPTO_PASSPHRASE=dev-oidc-crypto-passphrase-change-me

# Gateway secrets (shared only between Apache gateway and Hono backend)
GW_SECRET_GW_1=dev-gw-secret-1-alpha-bravo-charlie
GW_SECRET_GW_2=dev-gw-secret-2-delta-echo-foxtrot
GW_SECRET_GW_3_INT=dev-gw-secret-3-int-golf-hotel-india
GW_SECRET_GW_3_EXT=dev-gw-secret-3-ext-juliet-kilo-lima
GW_SECRET_GW_4_INT=dev-gw-secret-4-int-mike-november-oscar
GW_SECRET_GW_4_EXT=dev-gw-secret-4-ext-papa-quebec-romeo
GW_SECRET_GW_6_INT=dev-gw-secret-6-int-sierra-tango-uniform
GW_SECRET_GW_6_EXT=dev-gw-secret-6-ext-victor-whiskey-xray
GW_SECRET_GW_7_INT=dev-gw-secret-7-int-yankee-zulu-alpha
GW_SECRET_GW_7_EXT=dev-gw-secret-7-ext-bravo-charlie-delta

# OIDC Client Secrets (shared between Apache gateway and Keycloak realms)
OIDC_SECRET_APP_ARCH1=dev-oidc-secret-app-arch1-sierra
OIDC_SECRET_APP_ARCH2=dev-oidc-secret-app-arch2-tango
OIDC_SECRET_APP_ARCH3_INT=dev-oidc-secret-app-arch3-int-uniform
OIDC_SECRET_APP_ARCH3_EXT=dev-oidc-secret-app-arch3-ext-victor
OIDC_SECRET_APP_ARCH4_INT=dev-oidc-secret-app-arch4-int-whiskey
OIDC_SECRET_APP_ARCH6_INT=dev-oidc-secret-app-arch6-int-echo
OIDC_SECRET_APP_ARCH6_EXT=dev-oidc-secret-app-arch6-ext-foxtrot
OIDC_SECRET_APP_ARCH7_INT=dev-oidc-secret-app-arch7-int-golf
OIDC_SECRET_APP_ARCH7_EXT=dev-oidc-secret-app-arch7-ext-hotel
KC2_BROKER_SECRET=dev-kc2-broker-secret-xray-yankee-zulu
KC3_BROKER_SECRET=dev-kc3-broker-secret-alpha-mike-foxtrot
KC4_BROKER_SECRET=dev-kc4-broker-secret-bravo-oscar-tango

# backend-admin service-account secrets (backend -> external Keycloak admin API, app-admin user registration)
KC2_ADMIN_SECRET=dev-kc2-admin-secret-charlie-delta
KC3_ADMIN_SECRET=dev-kc3-admin-secret-echo-golf
KC4_ADMIN_SECRET=dev-kc4-admin-secret-hotel-india
