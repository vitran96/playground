    {
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\n\n// /** @type {Handler} **/\n// export const handler = async (input) => {\n//   return input;\n// };\n\n/**\n* @param {import('gorules').Input} input\n* @param {{\n*  moment: import('dayjs')\n*  env: Record<string, any>\n* }} helpers\n*/\nexport const handler = (input, { moment, env }) => {\n  const count = (flag) => Object.values(input?.flag || {}).reduce((acc, curr) => {\n    if (curr === flag) return acc + 1;\n    return acc;\n  }, 0);\n\n  return {\n    critical: count('critical'),\n    red: count('red'),\n    amber: count('amber'),\n    green: count('green')\n  };\n}"
      },
